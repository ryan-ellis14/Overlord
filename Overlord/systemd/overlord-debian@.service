[Unit]
Description=Overlord Kiosk Browser (Debian Variant)
After=graphical.target display-manager.service
Wants=graphical.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%h/.cache/dbus/session-bus
Environment=QT_QPA_PLATFORM=xcb
ExecStart=/opt/overlord/launch.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
